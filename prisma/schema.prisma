// Shop-locked licensing server for the EPos 365 WPF client.
// Behavioural spec: ../pos_customized/Licensing_Design.md
// Signed .lic file format: ../LICENSE_FILE.md

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // Transaction-mode pooler (port 6543) for the app: short-lived, high churn.
    url       = env("DATABASE_URL")
    // Session-mode pooler (port 5432) for DDL. The transaction pooler cannot
    // run migrations, so `db push` and `migrate` must not go through it.
    directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Licensing domain
// ---------------------------------------------------------------------------

/// A customer. Deliberately minimal per the design doc's "not a full CRM"
/// framing: just enough to make a license list human-readable and supportable.
///
/// Also doubles as the storefront-subdomain tenant record (see
/// ../../Epos365/SUBDOMAIN_ARCHITECTURE.md) — the `subdomain`/`customDomain`/
/// `styleConfig`/`templateId`/`isPublished` fields below are that addition.
/// One `Shop` concept, not two: a subdomain website belongs to the same
/// business the license belongs to. Those fields stay null until a customer
/// actually activates a subdomain (gated by `Customer.shopLimit`) — nothing
/// here is populated at registration time.
///
/// epos_corporate_web reads this table through a view,
/// `storefront."Shop"` (see Epos365/SHARED_DATABASE_SCHEMA.md). Adding
/// columns here is fine; dropping or retyping a column that view selects
/// will fail until the view is dropped and recreated. A new `TemplateId`
/// value also needs adding to that app's own `TemplateId` enum.
model Shop {
    id   String  @id @default(cuid())
    name String
    /// The owner/contact's own name, as distinct from the business name — the
    /// corporate website's quote form and registration form both collect one.
    contactName String?
    email       String?
    phone       String?
    notes       String?

    /// "royalkebab" — validated slug, immutable once published. Null until a
    /// subdomain is activated; most shops may never have one.
    subdomain String? @unique
    /// e.g. "royalkebab.ie" — null until the owner connects a custom domain.
    customDomain String? @unique
    /// Accent color, logo URL, hero copy, social links, product-grid layout —
    /// validated with a zod schema at read AND write time, not trusted as-is.
    styleConfig Json?
    /// Which shared template bundle renders this shop's storefront. Only
    /// `general` exists today — more values get appended as real template
    /// families are added, following the config-driven pattern already
    /// proven on the `asmfahim` branch of shopbridge (8 template families,
    /// one switch statement, no per-template Shop schema).
    templateId  TemplateId @default(general)
    isPublished Boolean    @default(false)
    publishedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    licenses License[]
    /// The shop owner's own login, if they self-registered. Null for shops an
    /// admin typed in by hand before self-registration existed, or a shop
    /// that only ever came from an anonymous quote request.
    ///
    /// Nullable — not every Shop has a Customer — and not unique on this
    /// side: one Customer account may own more than one Shop (see
    /// `Customer.shopLimit`). Was a strict one-to-one via `Customer.shopId`;
    /// flipped to this FK so a second shop per account is representable at
    /// all. License/Device/AppRelease/AuditEvent all key off `shopId`/
    /// `licenseId` directly and never touch `Customer`, so this flip does not
    /// change any field the WPF POS client reads — no client release needed
    /// for this change.
    customerId String?
    customer   Customer? @relation(fields: [customerId], references: [id])
    /// Quote requests submitted for this shop — see QuoteRequest below. A shop
    /// created purely from an anonymous quote may never get a License at all.
    quoteRequests QuoteRequest[]

    @@index([name])
    @@index([customerId])
}

/// One shared template bundle per shop. `restaurant` added 2026-08-29 —
/// the Postgres enum value already existed (added by epos_corporate_web's
/// schema, the app that actually renders templates) but this schema, the
/// only writer of Shop.templateId, hadn't been updated to know about it,
/// so a shop could never actually be set to it. Add values here (never
/// rename/remove one already in use) as real template families are built.
enum TemplateId {
    general
    restaurant
}

/// `expired` is deliberately absent: expiry is derived from `validUntil` on
/// read, so there is no second source of truth to fall out of sync with it.
/// Blocking is the only administrative hard stop.
enum LicenseStatus {
    active
    blocked
}

model License {
    id  String @id @default(cuid())
    /// The key the shop types into Settings > License. Format ABCD-1234-EFGH-5678.
    key String @unique

    shopId String
    shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

    /// Written into the signed blob's ShopLabel field, so it is what the
    /// cashier sees on their own License screen. Defaults to the shop name.
    shopLabel String?

    /// Per-license, not global, so a negotiated exception for one customer is a
    /// data change rather than a code change (Licensing_Design.md, open q. 6).
    maxDevices Int @default(2)

    status     LicenseStatus @default(active)
    validUntil DateTime
    issuedAt   DateTime      @default(now())

    /// Locality baseline for the license as a whole, snapshotted from the first
    /// device ever approved on it.
    ///
    /// It lives here, and not only on the baseline Device row, because the set of
    /// approved devices can legitimately become empty — an admin deactivating
    /// every till, or the stale-device reclaim below. When that happened, the geo
    /// check had nothing to compare against and `activateDevice` treated the next
    /// caller as the first device ever seen: auto-approved, from anywhere on
    /// earth, silently re-basing the locality check the whole feature exists for.
    /// Keeping the baseline on the license means an empty approved set is a
    /// recoverable state rather than an open door.
    baselineCountry String?
    baselineRegion  String?
    baselineIp      String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    devices     Device[]
    auditEvents AuditEvent[]

    @@index([shopId])
    @@index([status])
}

// ---------------------------------------------------------------------------
// Customer self-registration. See ../SELF_REGISTRATION_DESIGN.md.
//
// A Customer is a shop owner's own login — distinct from `User` below, which
// carries authority over every license in the system. Keeping them separate
// tables, not a role column on one, means a role-check bug can leak at worst
// into one other Customer's own data, never into admin authority.
// ---------------------------------------------------------------------------

model Customer {
    id String @id @default(cuid())
    /// Nullable: an admin can create a Customer purely as a licensing/business
    /// record (see Shop's own comment) with no email at all, same as the
    /// existing hand-typed-Shop workflow allowed. Still unique when present —
    /// Postgres treats multiple NULLs as distinct, so any number of emailless
    /// customers can coexist.
    email String? @unique
    /// bcrypt hash, cost 12 — matches admins.ts's BCRYPT_COST. Nullable: null
    /// means "no login set up yet", a normal state for an admin-managed
    /// customer who was never given self-service access. `signInCustomer`
    /// must reject a null hash explicitly rather than passing it to
    /// `compare`, which would throw. Set only through `setCustomerPassword`
    /// (admin panel or self-registration) — never by hand in the DB, since
    /// this column is always a hash, never a plaintext password.
    passwordHash    String?
    name            String?
    emailVerifiedAt DateTime?

    /// How many of this account's shops may have an *active subdomain* —
    /// not how many Shop rows exist (registration already creates one
    /// regardless). Defaults to 0: a new signup can download the POS app
    /// immediately but cannot activate a storefront subdomain until a
    /// platform admin raises this, either from the admin panel or directly
    /// in the DB — there is no pricing/plan system yet, so this is a plain
    /// manually-set number, not tier-derived. See
    /// ../../Epos365/SUBDOMAIN_ARCHITECTURE.md, "Milestone 1 scope".
    shopLimit Int @default(0)

    /// One account may own more than one Shop (see `shopLimit` above).
    /// Was `shopId String @unique` (strict one-to-one) — flipped to this
    /// back-relation so a second shop is representable; the FK now lives on
    /// `Shop.customerId` instead. Registration still creates exactly one
    /// Shop per signup today, so this is empty-or-single-element in
    /// practice until multi-shop accounts are a real feature.
    shops Shop[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sessions       CustomerSession[]
    passwordResets CustomerPasswordReset[]
    emailVerifications CustomerEmailVerification[]
}

/// A single-use link that confirms an owner's email address is theirs. Only
/// the token's hash is stored, with the address it was sent to: if the
/// address on the account has changed since, the link confirms nothing.
/// See src/server/customer/email-verification.ts. The table is created by
/// prisma/sql/customer-email-verification.sql.
model CustomerEmailVerification {
    id         String    @id @default(cuid())
    tokenHash  String    @unique
    customerId String
    customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
    email      String
    expiresAt  DateTime
    usedAt     DateTime?
    createdAt  DateTime  @default(now())

    @@index([customerId])
}

/// A single-use link that lets a shop owner choose a new password. Only the
/// token's hash is stored. See src/server/customer/password-reset.ts.
/// The table is created by prisma/sql/customer-password-reset.sql.
model CustomerPasswordReset {
    id         String    @id @default(cuid())
    tokenHash  String    @unique
    customerId String
    customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
    expiresAt  DateTime
    usedAt     DateTime?
    createdAt  DateTime  @default(now())

    @@index([customerId])
}

/// A plain DB-backed session, not a JWT: a stored row can be revoked by
/// deleting it (sign out everywhere on a compromised account), which a
/// stateless token cannot without a denylist. Deliberately its own table
/// rather than NextAuth's `Session`, which belongs to the admin `User` model.
model CustomerSession {
    id         String   @id @default(cuid())
    token      String   @unique
    customerId String
    customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
    expires    DateTime
    createdAt  DateTime @default(now())

    @@index([customerId])
}

/// One submission of the corporate website's "Get a free quote" form/price
/// calculator. Always attached to a Shop: a signed-in visitor's submission
/// attaches to their existing Shop (see /api/leads/quote-request), everyone
/// else gets a new one created for it — the same Shop a hand-typed admin
/// entry or a self-registration would produce, so there is one list of
/// "shops we know about" rather than a separate lead table per intake path.
model QuoteRequest {
    id     String @id @default(cuid())
    shopId String
    shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

    /// Takeaway / Restaurant / Café / Retail shop. Free text rather than an
    /// enum: it is marketing copy and will change more often than the schema.
    businessType String?
    message      String?
    /// Monthly estimate in euro cents at submission time, from the calculator.
    /// Integer cents, never a float. Null when the plain form was used instead.
    estimateCents Int?
    /// What the calculator had selected, as {optionId: quantity}.
    selection Json?

    /// When an admin marked this request as followed up, and which admin
    /// (their email). Null until then, which is what the Quote requests page
    /// counts as "not contacted yet".
    contactedAt DateTime?
    contactedBy String?

    createdAt DateTime @default(now())

    @@index([shopId])
}

enum DeviceStatus {
    /// Counts against maxDevices. Receives a signed blob on activate/checkin.
    approved
    /// Geo did not match the approved cluster. Sits in the review queue and
    /// does NOT count against maxDevices.
    pending
    /// Admin said no. Terminal; its next check-in gets 410.
    rejected
    /// Admin freed the slot (DELETE /device). Terminal for this row; the
    /// hardware may re-activate and will be treated as a brand new device.
    deactivated
}

/// One physical till. `deviceId` is the client's locally generated GUID,
/// `hardwareFingerprint` is the WMI-serial SHA-256 kept purely as an audit
/// trail (never as the shop-membership signal).
model Device {
    id String @id @default(cuid())

    licenseId String
    license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

    deviceId            String
    hardwareFingerprint String

    status DeviceStatus @default(pending)

    /// Locality signal recorded on every activate/checkin. The first approved
    /// device's values become the license's geo baseline.
    lastKnownIp String?
    geoCountry  String?
    geoRegion   String?
    geoCity     String?

    /// True for the first-ever approved device: the row every later device's
    /// geo is compared against.
    isBaseline Boolean @default(false)

    /// Which document-number block this till counts inside — 1, 2, 3… The client
    /// multiplies it by its block size, so till 2's invoices start at 1,000,001
    /// and cannot collide with till 1's while both are offline.
    ///
    /// Allocated here rather than typed in at the till because allocation needs
    /// one authority that knows the whole set, and this is the only thing that
    /// does. The till keeps a manual fallback for the case that matters: a
    /// machine that has never reached this server still has to trade, and still
    /// has to number what it sells.
    ///
    /// Assigned as `max + 1` over every row this license has ever had, never as
    /// "lowest free". Reuse looks tidier and is a trap: the till's counter only
    /// ever jumps FORWARD to a new floor, so a till moved to a lower block keeps
    /// issuing numbers in its old one — straight into the range now belonging to
    /// whichever till inherited it. Numbers are cheap; collisions are silent.
    ///
    /// Null on rows that have never been approved.
    terminalNumber Int?

    firstSeenAt DateTime  @default(now())
    lastCheckIn DateTime?
    approvedAt  DateTime?

    /// The fingerprint recorded before the current one, and how many times the
    /// device has flipped BACK to a fingerprint it had previously reported.
    ///
    /// These separate the two reasons a device id can report different hardware.
    /// A reimage or a motherboard swap changes the fingerprint once and then
    /// settles: `previousFingerprint` moves, `fingerprintAlternations` stays at
    /// zero. Two machines sharing one device id - the shape a copied database
    /// leaves behind - flip back and forth as each checks in, so the counter
    /// climbs and keeps climbing.
    ///
    /// Recorded and surfaced, never acted on. A false positive would force a
    /// legitimate till to re-activate and consume a slot the shop paid for, so
    /// this is evidence for a support conversation rather than a trigger. It has
    /// a real blind spot too: the client hashes "unknown" when WMI is locked
    /// down, so two such machines produce identical fingerprints and never flip.
    previousFingerprint     String?
    fingerprintAlternations Int     @default(0)

    /// When this till last released its own slot through POST /release.
    ///
    /// Only the client-initiated path writes it; an admin deactivating from the
    /// panel deliberately leaves it alone, because the rate limit exists to stop
    /// a shop cycling slots, not to stop support fixing something. Null means
    /// "never self-released", which is the state of every device predating this.
    lastSelfReleaseAt DateTime?

    /// Whether this till may publish the shop's catalogue to its website
    /// (POST /api/pos/v1/catalog). The till has its own permission check for
    /// staff, but that is a policy inside the till: this is the control the
    /// server can enforce, since it cannot see who is standing at the till.
    /// The first till to publish for a shop is granted it; after that the
    /// owner decides. Added by prisma/sql/pos-sync-schema.sql.
    canPublishCatalog Boolean @default(false)

    /// The public half of the key this till signs every /api/pos/v1 request
    /// with: base64 SubjectPublicKeyInfo, ECDSA P-256. The private half stays in
    /// the till's Windows key store and cannot be exported, so a copy of the
    /// till's database on another machine cannot make a request this service
    /// accepts. Null until the till registers one; cleared when the device
    /// stops being approved. Added by prisma/sql/pos-sync-schema.sql.
    posPublicKey   String?
    posPublicKeyAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    auditEvents AuditEvent[]

    /// A device may only appear once per license. Re-activating the same
    /// deviceId updates the existing row rather than creating a duplicate.
    @@unique([licenseId, deviceId])
    /// Two tills on one license may never hold the same document-number block.
    /// A constraint rather than a check in the allocator: two tills activating
    /// at the same moment both read the same `max`, and only the database can
    /// settle that. Postgres treats NULLs as distinct, so unapproved rows do not
    /// contend for the single null slot.
    @@unique([licenseId, terminalNumber])
    @@index([status])
    @@index([deviceId])
}

/// One published build of the WPF client.
///
/// Rows are append-only in practice: publishing a new version means adding a
/// row, never editing the old one, so the audit feed and any till that has
/// already been told about a version keep agreeing about what that version was.
///
/// The newest published row is the one every till is measured against — see
/// `currentRelease` in the licensing service.
model AppRelease {
    id String @id @default(cuid())

    /// The build being offered, e.g. "0.4.0". Compared against the till's own
    /// assembly version (the same number Settings > About shows).
    version String

    /// The hard floor. A till older than this is refused checkout, exactly as a
    /// blocked licence is.
    ///
    /// A floor rather than a per-release "mandatory" flag on purpose. A flag
    /// lives on whichever row is newest, so publishing a later optional release
    /// would silently lift the block an earlier mandatory one imposed — the
    /// shops furthest behind, the ones the block was for, would be released
    /// first. A floor only ever ratchets upward. The admin form still presents
    /// this as the soft/hard choice it is: "hard" sets it to `version`, "soft"
    /// leaves the previous floor where it was.
    minimumVersion String

    /// Where the installer lives. Must be https — the client will not execute
    /// anything fetched over plain http.
    downloadUrl String

    /// Lowercase hex SHA-256 of the installer at `downloadUrl`.
    ///
    /// The signature over this row covers the URL, but a URL is a pointer: it
    /// says nothing about the bytes served from it later. The client downloads
    /// and RUNS this file unattended, so it verifies the hash before executing
    /// and falls back to merely opening the link when this is absent. Nullable
    /// only so a row can exist before the hash is known; publish without it and
    /// the auto-install path stays switched off.
    sha256 String?

    /// Shown to the shop under the update banner. Plain text, kept short.
    notes String?

    /// Unpublished rows are invisible to every till, so a release can be staged
    /// and checked before anyone is offered it.
    isPublished Boolean   @default(false)
    publishedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isPublished, publishedAt])
}

// ---------------------------------------------------------------------------
// Pricing. Feeds the corporate website's price calculator (Epos365 repo,
// `_actions/quote.ts`/`quote-section.tsx`) via GET /api/pricing below. One
// platform-wide price list, not per-shop — every figure is in cents, never a
// float, matching `QuoteRequest.estimateCents`'s convention.
// ---------------------------------------------------------------------------

/// The till software itself. A single row in practice — the client offers
/// one product, billable three ways — but modelled as a table rather than a
/// handful of loose columns so a second plan is a new row, not a schema
/// change. `isActive` rather than delete: an old plan a customer is still
/// paying under should stay readable in the admin panel.
///
/// Each price is nullable independently: a plan need not be offered under
/// all three cycles (e.g. one-time-only, no subscription option). Null means
/// "not offered this way," not "free" — the calculator/site must hide, not
/// zero-price, an absent cycle.
model PricingPlan {
    id          String @id @default(cuid())
    name        String @default("EPos 365")
    description String?

    oneTimeCents Int?
    monthlyCents Int?
    yearlyCents  Int?

    isActive  Boolean @default(true)
    sortOrder Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive, sortOrder])
}

/// One line item the calculator can add on top of the plan — a till, a
/// kitchen printer, the card terminal. Same nullable-per-cycle shape as
/// `PricingPlan`: the card terminal, for instance, may only ever be offered
/// as a monthly rental, never a one-time purchase.
model HardwareItem {
    id   String  @id @default(cuid())
    name String
    /// Short clarifier shown under the name, e.g. "15" touch screen".
    note String?

    oneTimeCents Int?
    monthlyCents Int?
    yearlyCents  Int?

    /// How many of this item a shop may add in the calculator. `minQuantity`
    /// above 0 makes it always-on and not removable (e.g. a till bundled
    /// into every plan) — see the corporate site's `CalculatorOption.fixed`.
    minQuantity Int @default(0)
    maxQuantity Int @default(1)

    isActive  Boolean @default(true)
    sortOrder Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive, sortOrder])
}

enum AuditEventType {
    license_created
    license_updated
    license_blocked
    license_unblocked
    license_key_regenerated
    shop_created
    shop_updated
    customer_registered
    customer_created
    customer_updated
    customer_password_set
    quote_requested
    admin_created
    admin_deleted
    admin_password_changed
    activation_approved
    activation_pending
    activation_denied_device_limit
    activation_denied_blocked
    checkin
    checkin_denied
    device_approved
    device_rejected
    device_deactivated
    license_file_generated
    release_published
    release_unpublished
    pricing_plan_updated
    hardware_item_created
    hardware_item_updated
    hardware_item_deleted
}

/// Append-only feed. Nothing in the app updates or deletes these rows.
model AuditEvent {
    id   String         @id @default(cuid())
    type AuditEventType

    licenseId String?
    license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

    deviceId String?
    device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    /// Human-readable one-liner rendered directly in the audit view.
    summary String

    /// Who caused it: an admin's email, or "client" for machine-driven events.
    actor String

    ip   String?
    geo  String?
    /// Any extra structured context worth keeping (limits, old/new values).
    meta Json?

    createdAt DateTime @default(now())

    @@index([createdAt])
    @@index([licenseId, createdAt])
    @@index([type])
}

// ---------------------------------------------------------------------------
// Admin auth. Accounts live here and are managed from the panel; the seed
// script only bootstraps the first one, since somebody has to be able to sign
// in before anybody can be added through the UI.
//
// Every account carries the same authority. Licensing_Design.md anticipates a
// reseller-scoped role later, and adding a `role` column here is all that would
// take.
// ---------------------------------------------------------------------------

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    /// bcrypt hash, cost 12. Null means the account cannot sign in with a
    /// password, which is what an OAuth-only account would look like if one is
    /// ever added.
    passwordHash  String?
    createdAt     DateTime  @default(now())
    /// Defaulted as well as `@updatedAt` so the column could be added to a
    /// table that already had the bootstrap account in it.
    updatedAt     DateTime  @default(now()) @updatedAt
    accounts      Account[]
    sessions      Session[]
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
