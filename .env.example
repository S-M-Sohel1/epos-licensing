# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
AUTH_SECRET=""

# Prisma / Supabase
# Local dev: ./start-database.sh gives you the localhost URL below.
# Supabase: use the pooled connection string (port 6543, ?pgbouncer=true) from
# Project settings > Database > Connection string > Transaction pooler.
DATABASE_URL="postgresql://postgres:password@localhost:5432/epos-licensing"

# The session-mode pooler (port 5432). Prisma uses it for DDL only: the
# transaction pooler cannot run migrations, so `db push` and `migrate` fail
# without this. Leave unset when pointing DATABASE_URL at a plain Postgres.
DIRECT_URL=""

# Production RSA-2048 signing key, PKCS#8 PEM on one line with newlines written
# as literal \n (the form Vercel's env var UI produces). Generate with:
#
#   node scripts/generate-keypair.mjs
#
# which prints both this value and the PKCS#1 public key to paste into the WPF
# client's Pos.Core/Services/LicenseBlobSigning.cs. Treat this as a secret:
# anyone holding it can mint licenses the client will accept. It belongs in the
# Vercel/Supabase environment only, never in the repo and never in a log line.
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----"

# Bootstrap only. `pnpm db:seed` uses these to create the FIRST administrator,
# and refuses to do anything once one exists. Every account after that is added
# from the panel's Administrators page, and nothing reads these at runtime, so
# delete them from the environment after the first run.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Cloudflare R2: product pictures published by a till, stored as {shopId}/{hash}.{ext}.
# Leave blank to run without pictures: the picture endpoints answer 503 and the
# rest of catalogue sync is unaffected.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
# A secret. Server environment only.
R2_SECRET_ACCESS_KEY=""
# Public address the bucket is served from, no trailing slash (an r2.dev URL or a custom domain).
R2_PUBLIC_BASE_URL=""

# The web platform: the one deployment of epos_corporate_web that serves the corporate site and
# every shop's storefront. One address for the whole platform (e.g. https://epos-365.com), NOT a
# shop's storefront subdomain, and no trailing slash. After a till publishes its catalogue this
# service calls <WEB_PLATFORM_URL>/api/internal/pos-catalog/apply. Leave blank and each shop's
# menu still catches up within a minute by itself.
WEB_PLATFORM_URL=""
# 16+ characters, the same value as INTERNAL_API_SECRET in epos_corporate_web.
INTERNAL_API_SECRET=""

# The till's order nudge over Supabase Realtime. The same three values the corporate website's
# server has. Leave blank and tills ask for orders once a minute instead of being told at once.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
REALTIME_SIGNING_KEY=""
